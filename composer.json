{
    "name": "itk-dev/drupal_translation_extractor",
    "description": "drupal_translation_extractor",
    "license": "MIT",
    "type": "drupal-module",
    "require": {
        "php": "^8.4",
        "drupal/core": "^11.4",
        "drush/drush": "^13.8",
        "symfony/translation": "^7 || ^8",
        "symfony/twig-bridge": "^7 || ^8"
    },
    "require-dev": {
        "drupal/core-dev": "^11.4",
        "ergebnis/composer-normalize": "^2.54",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.8",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\drupal_translation_extractor\\": "src/",
            "Drupal\\drupal_translation_extractor\\Test\\": "tests/",
            "Drupal\\locale\\": "web/core/modules/locale/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        }
    }
}
